{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "e2e/src",
    "e2e/test",
    "examples/*/src",
    "examples/*/test",
    "examples/*/vite.config.ts",
    "examples/*/bundle-budget.ts",
    "test",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/test/fixtures/**",
    "third_party/**"
  ]
}
