{
  "name": "sdk-zk-cmi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && pnpm run depcruise && pnpm run typecheck",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit --project parity --project circuits",
    "test:unit": "vitest run --project unit",
    "test:parity": "vitest run --project parity",
    "test:circuits": "vitest run --project circuits",
    "postinstall": "pnpm --filter @ctd/sdk run build",
    "test:proving": "vitest run --project proving",
    "test:browser": "vitest run --project browser",
    "test:integration": "vitest run --project integration",
    "test:examples": "vitest run --project examples",
    "test:release": "vitest run --project release",
    "e2e": "pnpm --filter @zolvency-cmi/e2e exec tsx src/run.ts",
    "build": "node scripts/build-packages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/browser": "3.2.7",
    "dependency-cruiser": "17.4.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "playwright": "1.55.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "msgpackr-extract"
    ]
  }
}
