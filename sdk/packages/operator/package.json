  "description": "SDK do operador do CMI Auctions (só Node): leitura dos lances, alocação, settlement e keeper.",
  "private": false,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zolvency-CMI/sdk.git",
