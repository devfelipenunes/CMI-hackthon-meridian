{
  "name": "@zolvency-cmi/core",
  "version": "0.1.0",
  "description": "Núcleo do SDK do CMI Auctions: cripto ZK (Poseidon2, Grumpkin), witness e provas UltraHonk, Confidential Token e acesso à Stellar/Soroban.",
  "private": false,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zolvency-CMI/sdk.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs"
  },
  "publishConfig": {
    "access": "public",
