    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "dependencies": {
    "@aztec/bb.js": "0.87.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@noir-lang/noir_js": "1.0.0-beta.9",
    "@stellar/stellar-sdk": "14.6.1",
    "@zkpassport/poseidon2": "0.6.2",
    "@zolvency-cmi/artifacts": "workspace:*"
  },
  "devDependencies": {
    "@ctd/sdk": "workspace:*"
  }
}
